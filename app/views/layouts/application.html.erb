<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= content_for?(:title) ? yield(:title) : "SWiiTroom - Plataforma Profesional de Telemetría y Biomecánica" %></title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/xlsx-js-style@1.2.0/dist/xlsx.bundle.js"></script>

  <link rel="stylesheet" href="/css/swiitroom.css">
  <%= yield :head %>
</head>
<body class="<%= content_for?(:body_class) ? yield(:body_class) : 'flex flex-col' %>">
  <%= yield %>
</body>
</html>
